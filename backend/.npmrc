# ============================================================
# Configuración de npm — nivel proyecto
# ============================================================

# ---- Registry ----
registry=https://registry.npmjs.org/

# ---- Instalación ----
save-exact=false
package-lock=true

# ---- Rendimiento ----
fund=false
audit=false
progress=false

# ---- Seguridad ----
strict-ssl=true
fetch-timeout=60000
fetch-retries=3

# ---- Peer dependencies ----
# Opción correcta en npm 10+ (antes era strict-peer-dependencies)
strict-peer-deps=false
legacy-peer-deps=false

# ---- Engine checks ----
engine-strict=true