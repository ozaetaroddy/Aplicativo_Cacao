{
  "name": "cacao-backend",
  "version": "2.8.0",
  "description": "API backend para sistema contable con facturación electrónica SRI Ecuador",
  "main": "server.js",
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Cacao Backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tu-usuario/cacao-backend.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/cacao-backend/issues"
  },
  "homepage": "https://github.com/tu-usuario/cacao-backend#readme",
  "keywords": [
    "sri",
    "facturacion-electronica",
    "contabilidad",
    "ecuador",
    "express",
    "mongodb",
    "xades",
    "ats"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "server.js",
    "middleware/",
    "routes/",
    "utils/",
    "data/",
    "scripts/",
    "!.env*"
  ],
  "scripts": {
  "start": "node server.js",
  "dev": "nodemon server.js",

  "test": "node --test --test-reporter=spec",
  "test:watch": "node --test --watch",
  "test:one": "node --test",

  "seed:admin": "node scripts/seed-admin.js",
  "db:indices": "node scripts/crear-indices.js",
  "db:verificar": "node scripts/verificar-integridad.js",
  "db:backup": "node scripts/backup-manual.js",
  "db:saldos:recalc": "node scripts/recalcular-saldos.js",
  "db:limpiar:indices": "node scripts/limpiar-indices.js",

  "migrate:claves": "node scripts/migrate-claves.js",
  "migrate:claves:dry": "node scripts/migrate-claves.js --dry-run",
  "migrate:contadores": "node scripts/sincronizar-contadores.js",

  "revertir:claves": "node scripts/revertir-claves.js",
  "reset:contadores": "node scripts/resetear-contadores.js",

  "dup:facturas": "node scripts/detectar-duplicados-facturas.js",
  "fix:kardex": "node scripts/fix-kardex-costo.js",
  "cert:prueba": "node scripts/generar-certificado-prueba.js"
},

  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.8.1",
    "node-cron": "^4.6.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.0.9",
    "pino": "^9.4.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xml-crypto": "^6.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
