# ============================================
# SERVIDOR
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# MONGODB
# ============================================
MONGODB_URI=mongodb://localhost:27017
DB_NAME=cacao_db
# Pool de conexiones
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2

# ============================================
# JWT
# ============================================
# ⚠️  CAMBIAR EN PRODUCCIÓN por un string aleatorio largo (mín. 32 chars)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-minimo-32-chars
JWT_EXPIRES=8h

# ============================================
# CORS
# ============================================
# En producción: lista separada por comas. Ej:
# CORS_ORIGINS=https://app.midominio.com,https://admin.midominio.com
# En desarrollo: dejar vacío o no definir
CORS_ORIGINS=

# ============================================
# CIFRADO DEL CERTIFICADO .P12 (AES-256-GCM)
# ============================================
# ⚠️  CAMBIAR. Si esta clave cambia, los certificados guardados quedan inutilizables.
CERT_ENCRYPTION_KEY=otra-clave-larga-aleatoria-para-cifrar-certificados

# ============================================
# SMTP (para envío de comprobantes por email)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=tu-correo@gmail.com

# ============================================
# SRI
# ============================================
SRI_TIMEOUT_MS=45000
SRI_DEBUG=false


# Opcional: desactiva el registro público de vendedores
ALLOW_REGISTER=true

SMTP_TLS_REJECT_UNAUTHORIZED=true