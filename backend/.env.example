# ============================================================
# CONFIGURACIÓN DE ENTORNO — Ejemplo
# ------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores.
#
#   cp .env.example .env
#
# ⚠️  NUNCA subir `.env` real al repo.
# ⚠️  Todos los secretos deben ser aleatorios de 32+ caracteres:
#       node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Si estás detrás de Nginx/Render/Vercel/Railway, poner 1.
# Si el server está expuesto directo (dev local), dejar 0.
TRUST_PROXY_HOPS=1

# Límite del body JSON. Válido: 100kb, 1mb, 20mb (default).
JSON_BODY_LIMIT=20mb

# Rate limit global por IP (peticiones cada 15 min).
RATE_LIMIT_MAX=200

# ------------------------------------------------------------
# MONGODB
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DB_NAME=cacao_db
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2
MONGO_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=45000

# ------------------------------------------------------------
# JWT + COOKIES
# ------------------------------------------------------------
# ⚠️  CAMBIAR EN PRODUCCIÓN (mín. 32 chars aleatorios)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-minimo-32-chars

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# --- Cookies ---
# Dominio para las cookies. Dejar VACÍO en desarrollo (localhost).
COOKIE_DOMAIN=

# Si frontend y backend están en dominios DISTINTOS, poner true.
# ⚠️  Requiere HTTPS obligatorio (sameSite=none + secure).
COOKIE_CROSS_SITE=false

# Path del refresh token (default: /api/auth).
# COOKIE_REFRESH_PATH=/api/auth

# --- Refresh token reuse detection ---
AUTH_DETECT_REFRESH_REUSE=true
AUTH_REFRESH_REUSE_GRACE_MS=0

# --- Cache del middleware auth ---
AUTH_CACHE_TTL_MS=30000
AUTH_MAX_USERS=500
AUTH_MAX_TOKENS_USER=10

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Lista separada por comas. Ej:
#   CORS_ORIGINS=https://tu-app.vercel.app,https://www.tudominio.com
CORS_ORIGINS=

# Orígenes para Socket.IO. Si no se define, usa CORS_ORIGINS.
# SOCKET_CORS_ORIGINS=https://tu-app.vercel.app

# ------------------------------------------------------------
# CIFRADO DE CERTIFICADO .P12 (AES-256-GCM)
# ------------------------------------------------------------
# ⚠️  CAMBIAR EN PRODUCCIÓN. Si pierdes esta clave, los certificados
#     guardados quedan inutilizables.
CERT_ENCRYPTION_KEY=otra-clave-larga-aleatoria-para-cifrar-certificados

# ------------------------------------------------------------
# SMTP (envío de comprobantes)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=tu-correo@gmail.com

# TLS estricto (default). Poner `false` SOLO si el SMTP usa cert autofirmado.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Admins para alertas (opcional, sobreescribe consulta a BD).
# ADMIN_EMAILS=admin1@correo.com,admin2@correo.com

# Límites de adjuntos y timeouts.
EMAIL_MAX_ATTACHMENT_MB=15
EMAIL_MAX_TOTAL_ATTACHMENT_MB=20
EMAIL_TIMEOUT_MS=30000
EMAIL_RETRY_MAX=3
EMAIL_VERIFY_TTL_MS=30000

# ------------------------------------------------------------
# SRI (facturación electrónica)
# ------------------------------------------------------------
SRI_TIMEOUT_MS=45000
SRI_REINTENTOS=2
SRI_BACKOFF_BASE_MS=1500
SRI_MAX_BYTES=10485760
SRI_ENVIO_Y_AUTORIZAR_TIMEOUT_MS=180000
SRI_MAX_CONSULTAS=5
SRI_DEBUG=false
# SRI_USER_AGENT=SistemaContable/2.7 (+nodejs)

# ------------------------------------------------------------
# CONSULTAS EXTERNAS (cédula → nombre)
# ------------------------------------------------------------
CONSULTAS_CACHE_DIAS=30
CONSULTAS_HTTP_TIMEOUT_MS=12000
CONSULTAS_MAX_CONTENT_BYTES=2097152
CONSULTAS_RATE_MAX=20
CONSULTAS_CB_UMBRAL=5
CONSULTAS_CB_COOLDOWN_MS=600000

# ------------------------------------------------------------
# BACKUPS
# ------------------------------------------------------------
# Backup automático.
BACKUP_CRON_DEFAULT=0 3 * * *
BACKUP_TIMEZONE=America/Guayaquil
BACKUP_MAX_AUTOMATICOS=30
BACKUP_MAX_AUTOMATICOS_MAX=365
BACKUP_LIMITE_MB=15
BACKUP_LOCK_MINUTOS=30
BACKUP_ALERTA_DESDE_FALLO=2
BACKUP_ALERTA_CADA_FALLOS=5
BACKUP_ALERTA_THROTTLE_MS=3600000
BACKUP_TIMEOUT_MS=300000
BACKUP_REINTENTOS=2
BACKUP_BACKOFF_BASE_MS=2000
BACKUP_SHUTDOWN_HANDLERS=true

# Retención de snapshots pre-restore.
BACKUP_RETENCION_PRE_RESTORE=10
BACKUP_RETENCION_DEFAULT=30
BACKUP_RETENCION_MAX=365

# Límites del archivo comprimido.
BACKUP_MAX_JSON_BYTES=536870912
BACKUP_GZIP_LEVEL=6

# ------------------------------------------------------------
# CIRCUIT BREAKER (genérico)
# ------------------------------------------------------------
CB_UMBRAL_FALLOS=5
CB_COOLDOWN_MS=600000
CB_TIMEOUT_MS=15000

# ------------------------------------------------------------
# TRANSACCIONES MONGO
# ------------------------------------------------------------
TRANSACTION_TIMEOUT_MS=60000
TRANSACTION_MAX_COMMIT_MS=10000
TRANSACTION_CACHE_TTL_MS=300000
TRANSACTION_LOG_STANDALONE_FALLBACK=true

# ------------------------------------------------------------
# AUDITORÍA
# ------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_MAX_STRING=2000
AUDIT_MAX_ARRAY=50
AUDIT_MAX_DEPTH=5
AUDIT_MAX_DETALLE=1000
AUDIT_MAX_DOC_NUM=200
AUDIT_MAX_UA=300

# ------------------------------------------------------------
# PAGINACIÓN
# ------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=200
PAGINATION_MAX_PAGE=100000
PAGINATION_MAX_DIAS_RANGO=1098
PAGINATION_CACHE_MAX=500

# ------------------------------------------------------------
# VALIDACIÓN
# ------------------------------------------------------------
VALIDACION_MAX_MENSAJES=20
VALIDACION_MAX_LONGITUD_MENSAJE=300

# ------------------------------------------------------------
# VALIDADORES
# ------------------------------------------------------------
VALIDATORS_MAX_LOGO_LEN=500000
VALIDATORS_EMAIL_MAX_LEN=254
VALIDATORS_PERMITIR_SVG_LOGO=true

# ------------------------------------------------------------
# GENERACIÓN DE CLAVES SRI
# ------------------------------------------------------------
EC_TIMEZONE=America/Guayaquil

# ------------------------------------------------------------
# XML DEL SRI
# ------------------------------------------------------------
XML_MAX_DETALLES=500
XML_MAX_LONGITUD_CAMPO=300
XML_MAX_BYTES=2097152

# ------------------------------------------------------------
# QR
# ------------------------------------------------------------
QR_WIDTH=200
QR_MARGIN=1
QR_ECC=M
QR_COLOR_DARK=#1a3a5c
QR_COLOR_LIGHT=#ffffff
QR_CACHE_MAX=100
QR_TIMEOUT_MS=5000

# ------------------------------------------------------------
# MÓDULOS DE NEGOCIO (límites de listados)
# ------------------------------------------------------------
# Ventas
VENTAS_MAX_DETALLES=500
VENTAS_MAX_SIN_PAGINAR=5000
VENTAS_MIGRAR_MAX_DOCS=5000
VENTAS_MIGRAR_CONFIRM=false

# Compras
IMPORT_BATCH_SIZE=50
IMPORT_MAX_LINEAS=500

# Productos
PRODUCTOS_MAX_SIN_PAGINAR=5000
PRODUCTOS_MAX_STOCK_BAJO=2000

# Clientes / Proveedores / Usuarios
PROVEEDORES_MAX_SIN_PAGINAR=2000
USUARIOS_MAX_SIN_PAGINAR=5000

# Kardex
KARDEX_MAX_SIN_PAGINAR=5000

# Reportes
REPORTES_MAX_EXPORT=5000
REPORTES_MES_MAX_DETALLE=5000

# Estados financieros
EEFF_MAX_DIAS_PERIODO=1098
EEFF_MAX_DESGLOSE=20

# Estados de cuenta / Cartera
EST_CACHE_CARTERA_MS=60000
EST_MAX_MOVIMIENTOS=5000
EST_MAX_CLIENTES_CARTERA=2000
EST_CACHE_MS=60000
EST_MAX_DIAS=30

# Pagos / Aging
PAGOS_MAX_DOCS_CARTERA=5000
PAGOS_MAX_SIN_PAGINAR=5000

# Retenciones
RETENCIONES_MAX_SIN_PAGINAR=5000

# Periodos
PERIODOS_CACHE_PER_REQUEST=true
PERIODOS_REQUIRE_CONFIRMATION=false

# Contadores
CONTADORES_* # (ninguna configurable por ahora)

# ------------------------------------------------------------
# CERTIFICADO
# ------------------------------------------------------------
CERT_MAX_BASE64_LEN=18874368
CERT_MAX_PASSWORD_LEN=200
CERT_DIAS_ALERTA=30

# ------------------------------------------------------------
# ERROR HANDLER
# ------------------------------------------------------------
# Errores de Mongo adicionales a considerar "de red".
# ERRORS_MONGO_NETWORK_EXTRA=MyCustomError,AnotherError
# ERRORS_MONGO_TIMEOUT_EXTRA=MyTimeoutError

# ------------------------------------------------------------
# MIDDLEWARE CSRF
# ------------------------------------------------------------
CSRF_ENABLED=true
CSRF_ALLOWED_ORIGINS=
CSRF_ALLOW_NO_COOKIES=true
CSRF_REQUIRE_XRW=true
CSRF_TOKEN_REQUIRED=false
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_NAME=csrf_token

# ------------------------------------------------------------
# LOGGER
# ------------------------------------------------------------
LOG_LEVEL=debug
# LOG_SILENT=true
# LOG_PRETTY=true
# LOG_KEEP_LEVEL=true
# LOG_SERVICIO=cacao-backend

# ------------------------------------------------------------
# SWAGGER
# ------------------------------------------------------------
SWAGGER_ENABLED=false
# SWAGGER_PATH=/api/docs
# SWAGGER_TITLE=Cacao Backend API
# SWAGGER_BASIC_AUTH=user:pass
# SWAGGER_SERVERS=/api;https://api.midominio.com/api

# ------------------------------------------------------------
# ÍNDICES
# ------------------------------------------------------------
# Fuerza re-creación de índices al arrancar.
INDICES_FORCE_REBUILD=false

# ------------------------------------------------------------
# OTROS
# ------------------------------------------------------------
ALLOW_REGISTER=true
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8