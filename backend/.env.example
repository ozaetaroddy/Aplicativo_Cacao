# ============================================
# SERVIDOR
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# MONGODB
# ============================================
MONGODB_URI=mongodb://localhost:27017
DB_NAME=cacao_db
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2

# ============================================
# JWT + COOKIES
# ============================================
# ⚠️  CAMBIAR EN PRODUCCIÓN (mín. 32 chars aleatorios)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-minimo-32-chars

# Tiempos de vida
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Dominio para las cookies. Dejar VACÍO en desarrollo (localhost).
# En producción, si frontend y backend comparten dominio padre (ej: app.midominio.com
# y api.midominio.com), poner: .midominio.com
COOKIE_DOMAIN=

# Si frontend y backend están en dominios DISTINTOS (ej: Vercel + Render),
# activa esto. Requiere HTTPS obligatoriamente.
COOKIE_CROSS_SITE=false

# ============================================
# CORS
# ============================================
# Lista separada por comas. Ejemplo:
# CORS_ORIGINS=https://app.midominio.com,https://www.midominio.com
CORS_ORIGINS=

# Trust proxy (número de hops). 1 si estás detrás de Nginx/Vercel/Render.
TRUST_PROXY_HOPS=1

# ============================================
# CIFRADO DEL CERTIFICADO .P12 (AES-256-GCM)
# ============================================
CERT_ENCRYPTION_KEY=otra-clave-larga-aleatoria-para-cifrar-certificados

# ============================================
# SMTP
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=tu-correo@gmail.com
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ============================================
# SRI
# ============================================
SRI_TIMEOUT_MS=45000
SRI_DEBUG=false

# ============================================
# OTROS
# ============================================
ALLOW_REGISTER=true
RATE_LIMIT_MAX=200