# ============================================
# SERVIDOR
# ============================================
PORT=5000
NODE_ENV=development

# Si estás detrás de Nginx/Render/Vercel, poner 1.
TRUST_PROXY_HOPS=1

# ============================================
# MONGODB
# ============================================
MONGODB_URI=mongodb://localhost:27017
DB_NAME=cacao_db
MONGO_POOL_MAX=20
MONGO_POOL_MIN=2

# ============================================
# JWT + COOKIES
# ============================================
# ⚠️  CAMBIAR EN PRODUCCIÓN (mín. 32 chars aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-minimo-32-chars

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Dominio para las cookies. Dejar VACÍO en desarrollo (localhost).
COOKIE_DOMAIN=

# ⚠️  IMPORTANTE:
#   - Si frontend y backend están en el MISMO dominio (o usas rewrites
#     de Vercel para /api), dejar COOKIE_CROSS_SITE=false.
#   - Si frontend en Vercel y backend en Render con dominios DISTINTOS
#     y llamas directo a Render, poner COOKIE_CROSS_SITE=true
#     (requiere HTTPS obligatorio, se activa SameSite=None).
COOKIE_CROSS_SITE=false

# ============================================
# CORS
# ============================================
# Lista separada por comas. Ej:
#   CORS_ORIGINS=https://tu-app.vercel.app,https://www.tudominio.com
CORS_ORIGINS=

# Orígenes para Socket.IO (WebSocket handshake). Si no se define,
# se usa CORS_ORIGINS.
# SOCKET_CORS_ORIGINS=https://tu-app.vercel.app

# ============================================
# CIFRADO DEL CERTIFICADO .P12 (AES-256-GCM)
# ============================================
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CERT_ENCRYPTION_KEY=otra-clave-larga-aleatoria-para-cifrar-certificados

# ============================================
# SMTP
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=tu-correo@gmail.com
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Emails de admin para alertas (opcional, sobreescribe la consulta a la BD)
# ADMIN_EMAILS=admin1@correo.com,admin2@correo.com

# ============================================
# SRI
# ============================================
SRI_TIMEOUT_MS=45000
SRI_DEBUG=false

# ============================================
# OTROS
# ============================================
ALLOW_REGISTER=true
RATE_LIMIT_MAX=200

# Swagger docs. En producción dejar 'false'.
# SWAGGER_ENABLED=false