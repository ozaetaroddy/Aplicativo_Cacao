# ============================================================
# API
# ============================================================
# En DESARROLLO:
#   VITE_API_BASE_URL=http://localhost:5000/api
#
# En PRODUCCIÓN con Vercel + Render (recomendado, evita CORS):
#   VITE_API_BASE_URL=/api
#   El rewrite de vercel.json se encarga de proxyear /api → Render.
#
# En PRODUCCIÓN llamando DIRECTO a Render (requiere CORS + SameSite=None):
#   VITE_API_BASE_URL=https://tu-servicio.onrender.com/api
#
VITE_API_BASE_URL=/api

# ============================================================
# SOCKET.IO (WebSocket)
# ============================================================
# En DESARROLLO dejar vacío → se calcula de VITE_API_BASE_URL.
#
# En PRODUCCIÓN con Vercel + Render:
#   Vercel NO soporta WebSocket rewrites.
#   Apunta DIRECTO al backend:
#     VITE_SOCKET_URL=https://tu-servicio.onrender.com
#
VITE_SOCKET_URL=

# ============================================================
# EMPRESA (solo fallback si el backend no responde)
# ============================================================
VITE_COMPANY_NAME=System Ozaet's Electronics
VITE_IVA_PERCENTAGE=15
VITE_COMPANY_RUC=1234567890001
VITE_COMPANY_PHONE=0999999999
VITE_COMPANY_ADDRESS=Quito, Ecuador
VITE_COMPANY_EMAIL=info@ozaet.com