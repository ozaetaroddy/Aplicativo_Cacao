# ============================================================
# API — Base URL del backend
# ------------------------------------------------------------
# DESARROLLO:
#   VITE_API_BASE_URL=http://localhost:5000/api
#   (o deja `/api` si usas el proxy de Vite con `npm run dev`)
#
# PRODUCCIÓN en Vercel + Render (RECOMENDADO, evita CORS):
#   VITE_API_BASE_URL=/api
#   El rewrite de vercel.json se encarga de proxyear /api → Render.
#
# PRODUCCIÓN llamando DIRECTO a Render (requiere CORS + SameSite=None):
#   VITE_API_BASE_URL=https://tu-servicio.onrender.com/api
# ============================================================
VITE_API_BASE_URL=/api

# ============================================================
# SOCKET.IO — WebSocket
# ------------------------------------------------------------
# DESARROLLO:
#   Dejar vacío → se calcula automáticamente desde VITE_API_BASE_URL.
#
# PRODUCCIÓN en Vercel + Render:
#   ⚠️  Vercel NO soporta rewrites de WebSocket.
#   Apuntar DIRECTO al backend en Render (sin /api al final):
#     VITE_SOCKET_URL=https://tu-servicio.onrender.com
# ============================================================
VITE_SOCKET_URL=

# ============================================================
# DEV SERVER — solo para `npm run dev`
# ------------------------------------------------------------
# URL del backend local al que el proxy de Vite reenvía /api/*.
# Cambiar si tu backend corre en otro puerto o máquina.
# ============================================================
VITE_DEV_BACKEND=http://localhost:5000

# ============================================================
# EMPRESA — fallback si el backend no responde
# ------------------------------------------------------------
# Estos valores se usan SOLO como placeholder mientras carga la
# configuración real desde el backend. NO son la fuente de verdad.
# ============================================================
VITE_COMPANY_NAME=System Ozaet's Electronics
VITE_COMPANY_RUC=1234567890001
VITE_COMPANY_PHONE=0999999999
VITE_COMPANY_ADDRESS=Quito, Ecuador
VITE_COMPANY_EMAIL=info@ozaet.com

# ============================================================
# NEGOCIO — defaults de la UI
# ============================================================
# IVA por defecto al crear una factura nueva (el backend valida
# que el valor sea 0, 5 o 15).
VITE_IVA_PERCENTAGE=15

# Moneda por defecto (Ecuador = USD).
VITE_CURRENCY=USD

# ============================================================
# FEATURE FLAGS — activar/desactivar features sin redeploy
# ------------------------------------------------------------
# 'true' habilita, cualquier otra cosa desactiva.
# ============================================================
VITE_ENABLE_PWA=true
VITE_ENABLE_TOUR=true
VITE_ENABLE_INACTIVITY_LOGOUT=true

# ============================================================
# DEBUG
# ------------------------------------------------------------
# Activa logs verbosos en consola (solo útil en dev).
# ============================================================
VITE_DEBUG=false